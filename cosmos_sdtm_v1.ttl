cosmos_sdtm:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    skos:definition "Submission value for assigned term in NCIt if it exists, or an assigned value which will be the default value" ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:vlmTarget a owl:DatatypeProperty ;
