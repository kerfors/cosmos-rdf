cosmos_sdtm:conceptId a owl:DatatypeProperty ;
    rdfs:label "conceptId" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^(C[0-9]+|CNEW)$" ] ) ] ) ] ;
