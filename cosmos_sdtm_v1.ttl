cosmos_sdtm:SDTMVariable a owl:Class ;
    rdfs:label "SDTMVariable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cosmos_sdtm:AssignedTerm ;
            owl:onProperty cosmos_sdtm:assignedTerm ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cosmos_sdtm:assignedTerm ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[A-Z][A-Z0-9_]*$" ] ) ] ) ] ;
            owl:onProperty cosmos_sdtm:subsetCodelist ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cosmos_sdtm:mandatoryVariable ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cosmos_sdtm:comparator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cosmos_sdtm:subsetCodelist ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cosmos_sdtm:codelist ],
        [ a owl:Restriction ;
            owl:allValuesFrom cosmos_sdtm:CodeList ;
