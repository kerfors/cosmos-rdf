cosmos_sdtm:originSource a owl:ObjectProperty ;
    rdfs:label "originSource" ;
    rdfs:range cosmos_sdtm:OriginSourceEnum ;
    skos:definition "Variable origin source (define-XML v21)" ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:originType a owl:ObjectProperty ;
    rdfs:label "originType" ;
    rdfs:range cosmos_sdtm:OriginTypeEnum ;
    skos:definition "Variable origin type (define-XML v21)" ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:packageDate a owl:DatatypeProperty ;
    rdfs:label "packageDate" ;
    rdfs:range xsd:date ;
    skos:definition "Biomedical Concept package release date indicating when the BC package was published to production" ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:packageType a owl:ObjectProperty ;
    rdfs:label "packageType" ;
    rdfs:range cosmos_sdtm:PackageTypeEnum ;
    skos:definition "Package type (sdtm for SDTM Dataset Specializations)" ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:parentCodelist a owl:DatatypeProperty ;
    rdfs:label "parentCodelist" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^C[0-9]+$" ] ) ] ) ] ;
    skos:definition "Subset codelist parent codelist" ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:predicateTerm a owl:ObjectProperty ;
    rdfs:label "predicateTerm" ;
    rdfs:range cosmos_sdtm:PredicateTermEnum ;
    skos:definition "Short variable relationship linking phrase for programming purposes" ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:relationship a owl:ObjectProperty ;
    rdfs:label "relationship" ;
    rdfs:range cosmos_sdtm:RelationShip ;
    skos:definition "Relationship between variables" ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:role a owl:ObjectProperty ;
    rdfs:label "role" ;
    rdfs:range cosmos_sdtm:RoleEnum ;
    skos:definition "SDTM variable role" ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:sdtmigEndVersion a owl:DatatypeProperty ;
    rdfs:label "sdtmigEndVersion" ;
    rdfs:range xsd:string ;
    skos:definition "The last SDTMIG version that is applicable to the BC dataset specialization" ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:sdtmigStartVersion a owl:DatatypeProperty ;
    rdfs:label "sdtmigStartVersion" ;
    rdfs:range xsd:string ;
    skos:definition "The earliest SDTMIG version applicable to the BC dataset specialization" ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:shortName a owl:DatatypeProperty ;
    rdfs:label "shortName" ;
    rdfs:range xsd:string ;
    skos:definition "SDTM group short name which provides a user friendly and intuitive name for the vlm_group_id" ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:significantDigits a owl:DatatypeProperty ;
    rdfs:label "significantDigits" ;
    rdfs:range xsd:integer ;
    skos:definition "Variable significant_digits" ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:source a owl:DatatypeProperty ;
    rdfs:label "source" ;
    rdfs:range xsd:string ;
    skos:definition "SDTM VLM Source which categorizes VLM groups by topic variable" ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:subject a owl:DatatypeProperty ;
    rdfs:label "subject" ;
    rdfs:range xsd:string ;
    skos:definition "Subject in a variable relationship" ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:submissionValue a owl:DatatypeProperty ;
    rdfs:label "submissionValue" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[A-Z][A-Z0-9_]*$" ] ) ] ) ] ;
    skos:definition "CDISC submission value for the codelist" ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:subsetCodelist a owl:DatatypeProperty ;
    rdfs:label "subsetCodelist" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[A-Z][A-Z0-9_]*$" ] ) ] ) ] ;
    skos:definition "Subset codelist short name" ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:subsetLabel a owl:DatatypeProperty ;
    rdfs:label "subsetLabel" ;
    rdfs:range xsd:string ;
