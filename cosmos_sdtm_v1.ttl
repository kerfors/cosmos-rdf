@prefix NCIT: <http://purl.obolibrary.org/obo/NCIT_> .
@prefix cosmos_sdtm: <https://www.cdisc.org/cosmos/sdtm_v1.0/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:bibliographicCitation a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

<https://w3id.org/cdisc/cosmos/sdtm/> a owl:Ontology ;
    rdfs:label "CDISC COSMoS SDTM Dataset Specializations (RDF/OWL rendering)" ;
    dcterms:bibliographicCitation "Forsberg, K. (2026). CDISC COSMoS SDTM Dataset Specializations (RDF/OWL rendering). https://w3id.org/cdisc/cosmos/sdtm/" ;
    dcterms:created "2026-09-01"^^xsd:date ;
    dcterms:creator "Kerstin Forsberg" ;
    dcterms:description "A mechanical OWL rendering of the LinkML schema CDISC publishes as model/cosmos_sdtm_model.yaml in cdisc-org/COSMoS: the SDTM group, variable, relationship and codelist classes, their required and ordered slots, identifier patterns, and the controlled enumerations - including the reification vocabulary (predicate terms, linking phrases) and the Define-XML origin terminology with its NCIt meanings. Class and property IRIs are the ones the published schema declares; this rendering does not rename them." ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    dcterms:modified "2026-09-04"^^xsd:date ;
    dcterms:source <https://raw.githubusercontent.com/cdisc-org/COSMoS/031429b1d14823721991cd23ee88a11616686ce3/model/cosmos_sdtm_model.yaml> ;
    dcterms:title "CDISC COSMoS SDTM Dataset Specializations (RDF/OWL rendering)" ;
    vann:preferredNamespacePrefix "cosmos_sdtm" ;
    vann:preferredNamespaceUri cosmos_sdtm: ;
    rdfs:comment "Mechanical rendering of a published CDISC COSMoS LinkML schema. Draft - not a normative CDISC artifact." ;
    owl:versionIRI <https://w3id.org/cdisc/cosmos/sdtm/0.3.0> ;
    owl:versionInfo "v0.3.0" .

cosmos_sdtm:SDTMGroup a owl:Class ;
    rdfs:label "SDTMGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cosmos_sdtm:biomedicalConceptId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty cosmos_sdtm:packageDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^(C[0-9]+|NEW_[A-Z_]*[0-9]*)$" ] ) ] ) ] ;
            owl:onProperty cosmos_sdtm:biomedicalConceptId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:biomedicalConceptId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cosmos_sdtm:domain ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cosmos_sdtm:sdtmigStartVersion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:domain ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:sdtmigStartVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom cosmos_sdtm:SDTMVariable ;
            owl:onProperty cosmos_sdtm:variables ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:packageDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cosmos_sdtm:domain ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cosmos_sdtm:sdtmigStartVersion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cosmos_sdtm:sdtmigEndVersion ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cosmos_sdtm:packageDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cosmos_sdtm:source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:datasetSpecializationId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cosmos_sdtm:sdtmigEndVersion ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cosmos_sdtm:variables ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:sdtmigEndVersion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:packageType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cosmos_sdtm:datasetSpecializationId ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cosmos_sdtm:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[A-Z][A-Z0-9_]*$" ] ) ] ) ] ;
            owl:onProperty cosmos_sdtm:datasetSpecializationId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cosmos_sdtm:shortName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:shortName ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cosmos_sdtm:packageType ],
        [ a owl:Restriction ;
            owl:allValuesFrom cosmos_sdtm:PackageTypeEnum ;
            owl:onProperty cosmos_sdtm:packageType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cosmos_sdtm:shortName ] ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:SubsetCodeList a owl:Class ;
    rdfs:label "SubsetCodeList" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cosmos_sdtm:subsetLabel ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:subsetLabel ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:parentCodelist ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cosmos_sdtm:subsetLabel ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cosmos_sdtm:parentCodelist ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:subsetShortName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cosmos_sdtm:CodeListTerm ;
            owl:onProperty cosmos_sdtm:codelistTerm ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[A-Z][A-Z0-9_]*$" ] ) ] ) ] ;
            owl:onProperty cosmos_sdtm:subsetShortName ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^C[0-9]+$" ] ) ] ) ] ;
            owl:onProperty cosmos_sdtm:parentCodelist ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cosmos_sdtm:subsetShortName ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cosmos_sdtm:codelistTerm ] ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

<https://www.cdisc.org/cosmos/sdtm_v1.0/PackageTypeEnum#sdtm> a owl:Class ;
    rdfs:label "sdtm" ;
    rdfs:subClassOf cosmos_sdtm:PackageTypeEnum .

NCIT:C170547 a owl:Class ;
    rdfs:label "Assigned" ;
    rdfs:subClassOf cosmos_sdtm:OriginTypeEnum ;
    skos:definition "A value that is derived through designation, such as values from a look up table or a label on a CRF." .

NCIT:C170548 a owl:Class ;
    rdfs:label "Collected" ;
    rdfs:subClassOf cosmos_sdtm:OriginTypeEnum ;
    skos:definition "A value that is actually observed and recorded by a person or obtained by an instrument." .

NCIT:C170549 a owl:Class ;
    rdfs:label "Derived" ;
    rdfs:subClassOf cosmos_sdtm:OriginTypeEnum ;
    skos:definition "A value that is calculated by an algorithm or reproducible rule, and which is dependent upon other data values." .

NCIT:C170550 a owl:Class ;
    rdfs:label "Predecessor" ;
    rdfs:subClassOf cosmos_sdtm:OriginTypeEnum ;
    skos:definition "A value that is copied from a variable in another dataset." .

NCIT:C170551 a owl:Class ;
    rdfs:label "Protocol" ;
    rdfs:subClassOf cosmos_sdtm:OriginTypeEnum ;
    skos:definition "A value that is included as part of the study protocol." .

NCIT:C25936 a owl:Class ;
    rdfs:label "Investigator" ;
    rdfs:subClassOf cosmos_sdtm:OriginSourceEnum ;
    skos:definition "A person responsible for the conduct of the clinical trial at a trial site. If a trial is conducted by a team of individuals at the trial site, the investigator is the responsible leader of the team and may be called the principal investigator." .

NCIT:C41189 a owl:Class ;
    rdfs:label "Subject" ;
    rdfs:subClassOf cosmos_sdtm:OriginSourceEnum ;
    skos:definition "An individual who is observed, analyzed, examined, investigated, experimented upon, or/and treated in the course of a particular study." .

NCIT:C68608 a owl:Class ;
    rdfs:label "Vendor" ;
    rdfs:subClassOf cosmos_sdtm:OriginSourceEnum ;
    skos:definition "A person or agency that promotes or exchanges goods or services for money. (NCI)" .

NCIT:C70793 a owl:Class ;
    rdfs:label "Sponsor" ;
    rdfs:subClassOf cosmos_sdtm:OriginSourceEnum ;
    skos:definition "An individual, company, institution, or organization that takes responsibility for the initiation, management, and/or financing of a clinical study. [After ICH E6, WHO, 21 CFR 50.3 (e), and after IDMP]" .

cosmos_sdtm:AssignedTerm a owl:Class ;
    rdfs:label "AssignedTerm" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:conceptId ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^(C[0-9]+|CNEW)$" ] ) ] ) ] ;
            owl:onProperty cosmos_sdtm:conceptId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cosmos_sdtm:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cosmos_sdtm:conceptId ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cosmos_sdtm:value ] ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:CodeList a owl:Class ;
    rdfs:label "CodeList" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:conceptId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cosmos_sdtm:href ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^(C[0-9]+|CNEW)$" ] ) ] ) ] ;
            owl:onProperty cosmos_sdtm:conceptId ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cosmos_sdtm:conceptId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:submissionValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:href ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cosmos_sdtm:submissionValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cosmos_sdtm:href ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[A-Z][A-Z0-9_]*$" ] ) ] ) ] ;
            owl:onProperty cosmos_sdtm:submissionValue ] ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:CodeListTerm a owl:Class ;
    rdfs:label "CodeListTerm" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cosmos_sdtm:termValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:termValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:termId ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^(C[0-9]+)$" ] ) ] ) ] ;
            owl:onProperty cosmos_sdtm:termId ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cosmos_sdtm:termValue ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cosmos_sdtm:termId ] ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

<https://www.cdisc.org/cosmos/sdtm_v1.0/ComparatorEnum#EQ> a owl:Class ;
