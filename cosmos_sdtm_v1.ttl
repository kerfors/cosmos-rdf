        "C-code for assigned term in NCIt or left blank when CDISC terminology does not apply" ;
    skos:inScheme <https://www.cdisc.org/cosmos/sdtm_v1.0> .

cosmos_sdtm:OriginTypeEnum a owl:Class ;
