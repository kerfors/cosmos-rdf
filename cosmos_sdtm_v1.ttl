        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cosmos_sdtm:relationship ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:assignedTerm ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:mandatoryVariable ],
        [ a owl:Restriction ;
            owl:allValuesFrom cosmos_sdtm:ComparatorEnum ;
            owl:onProperty cosmos_sdtm:comparator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:comparator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:subsetCodelist ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cosmos_sdtm:codelist ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cosmos_sdtm:length ],
        [ a owl:Restriction ;
