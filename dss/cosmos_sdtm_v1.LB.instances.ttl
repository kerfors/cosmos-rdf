<https://w3id.org/cdisc/cosmos/dss/LB> a owl:Ontology ;
    rdfs:label "CDISC COSMoS Dataset Specializations, LB (instances)" ;
    dcterms:identifier "2026-07-14" ;
    dcterms:source <https://raw.githubusercontent.com/cdisc-org/COSMoS/031429b1d14823721991cd23ee88a11616686ce3/export/cdisc_sdtm_dataset_specializations_latest.csv> ;
    rdfs:comment "Dataset Specialization instances for domain LB, rendered from the pinned COSMoS export. Variable order is the export's row order, carried as rdf:_n membership beside the variables edges. length and significantDigits are cast from the export's decimal form to integer; packageType is not in the export and is set to the enum's single value. A biomedicalConceptId or dataElementConceptId that resolves to no node is carried as the published string. The concept nodes those edges reach are declared in the Biomedical Concept instance graph, which is not imported. Draft - not a normative CDISC artifact." ;
    owl:imports <https://w3id.org/cdisc/cosmos/sdtm/> ;
    owl:versionIRI <https://w3id.org/cdisc/cosmos/dss/LB/0.4.0> ;
    owl:versionInfo "v0.4.0" .

