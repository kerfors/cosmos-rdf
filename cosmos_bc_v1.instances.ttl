NCIT:C45398 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C45398" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45398> ;
    cosmos_bc:categories "Laboratory Tests",
        "Nitroso Carcinogens" ;
    cosmos_bc:definition "An organic N-nitroso compound with possible carcinogenic activity characterized by the group -NNO or -NHNO in its structure, formed by combining nitrates with amines. These compounds are found in various foods and many are carcinogenic or are suspected carcinogens. Cured meats can contain nitrosamines because meats contain amines and can react during cooking with sodium nitrite that is added as a preservative. (NCI05)" ;
    cosmos_bc:ncitCode "C45398" ;
    cosmos_bc:packageDate "2025-04-01"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:shortName "Carcinogenic Nitrosamine" .

