    cosmos_bc:dataElementConcepts <https://w3id.org/cdisc/cosmos/bc/C16809/dec/C117511>,
        <https://w3id.org/cdisc/cosmos/bc/C16809/dec/C117512>,
        <https://w3id.org/cdisc/cosmos/bc/C16809/dec/C117529>,
        <https://w3id.org/cdisc/cosmos/bc/C16809/dec/C117530>,
        <https://w3id.org/cdisc/cosmos/bc/C16809/dec/C127786>,
        <https://w3id.org/cdisc/cosmos/bc/C16809/dec/C13717>,
        <https://w3id.org/cdisc/cosmos/bc/C16809/dec/C171000>,
        <https://w3id.org/cdisc/cosmos/bc/C16809/dec/C25185>,
        <https://w3id.org/cdisc/cosmos/bc/C16809/dec/C25372>,
        <https://w3id.org/cdisc/cosmos/bc/C16809/dec/C25692>,
        <https://w3id.org/cdisc/cosmos/bc/C16809/dec/C54215> ;
    cosmos_bc:definition "Imaging that uses radiofrequency waves and a strong magnetic field rather than x-rays to provide detailed pictures of internal organs and tissues. The technique is valuable for the diagnosis of many pathologic conditions, including cancer, heart and vascular disease, stroke, and joint and musculoskeletal disorders." ;
    cosmos_bc:ncitCode "C16809" ;
    cosmos_bc:packageDate "2023-12-12"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C16502 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Nominal> ;
    cosmos_bc:shortName "Magnetic Resonance Imaging" ;
    cosmos_bc:synonyms "MRI",
        "MRI Scan",
        "Magnetic Resonance",
        "NMR",
        "NMR Imaging" .

NCIT:C168125 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C168125" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C168125> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Cardiovascular%20Examination>,
        <https://w3id.org/cdisc/cosmos/bc/category/Vital%20Signs> ;
    cosmos_bc:coding <http://loinc.org/44971-0> ;
    cosmos_bc:dataElementConcepts <https://w3id.org/cdisc/cosmos/bc/C168125/dec/C42574>,
        <https://w3id.org/cdisc/cosmos/bc/C168125/dec/C70856>,
        <https://w3id.org/cdisc/cosmos/bc/C168125/dec/C82515> ;
    cosmos_bc:definition "An assessment performed to estimate peripheral perfusion and hydration status. The test is most often conducted by applying constant manual pressure for a set time on a patient's nail bed and then releasing while observing the length of time it takes for color to return to the tissue. A prolonged return to baseline coloring may indicate compromise of peripheral blood flow." ;
    cosmos_bc:ncitCode "C168125" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C122008 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Capillary Refill Test" ;
    cosmos_bc:synonyms "CPLRFLT",
        "Capillary Refill Time" .

NCIT:C17007 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C17007" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C17007> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Diagnostic%20Imaging>,
        <https://w3id.org/cdisc/cosmos/bc/category/Medical%20Imaging>,
        <https://w3id.org/cdisc/cosmos/bc/category/Tomography> ;
    cosmos_bc:dataElementConcepts <https://w3id.org/cdisc/cosmos/bc/C17007/dec/C117511>,
        <https://w3id.org/cdisc/cosmos/bc/C17007/dec/C117512>,
        <https://w3id.org/cdisc/cosmos/bc/C17007/dec/C117529>,
        <https://w3id.org/cdisc/cosmos/bc/C17007/dec/C117530>,
        <https://w3id.org/cdisc/cosmos/bc/C17007/dec/C127786>,
        <https://w3id.org/cdisc/cosmos/bc/C17007/dec/C13717>,
        <https://w3id.org/cdisc/cosmos/bc/C17007/dec/C171000>,
        <https://w3id.org/cdisc/cosmos/bc/C17007/dec/C25185>,
        <https://w3id.org/cdisc/cosmos/bc/C17007/dec/C25372>,
        <https://w3id.org/cdisc/cosmos/bc/C17007/dec/C25692> ;
    cosmos_bc:definition "A technique for measuring the gamma radiation produced by collisions of electrons and positrons (anti-electrons) within living tissue. In positron emission tomography (PET), a subject is given a dose of a positron-emitting radionuclide attached to a metabolically active substance (for example, 2-fluoro-2-deoxy-D-glucose (FDG), which is similar to a naturally occurring sugar, glucose, with the addition of a radioactive fluorine atom). When living tissue containing the positron emitter is bombarded by electrons, gamma radiation produced by collisions of electrons and positrons is detected by a scanner, revealing in fine detail the tissue location of the metabolically-active substance administered." ;
    cosmos_bc:ncitCode "C17007" ;
    cosmos_bc:packageDate "2026-07-14"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C38093 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Nominal> ;
    cosmos_bc:shortName "Positron Emission Tomography" ;
    cosmos_bc:synonyms "PET",
        "PET Scan" .

NCIT:C170571 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170571" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170571> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Death%20Diagnosis%20and%20Details>,
        <https://w3id.org/cdisc/cosmos/bc/category/Indicator> ;
