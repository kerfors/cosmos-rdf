    dcterms:identifier "C115789" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C115789> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/6%20Minute%20Walk%20Functional%20Test>,
        <https://w3id.org/cdisc/cosmos/bc/category/6MWT>,
        <https://w3id.org/cdisc/cosmos/bc/category/Functional%20Assessment>,
        <https://w3id.org/cdisc/cosmos/bc/category/QRS>,
        <https://w3id.org/cdisc/cosmos/bc/category/SIX%20MINUTE%20WALK>,
        <https://w3id.org/cdisc/cosmos/bc/category/SIXMW1> ;
    cosmos_bc:dataElementConcepts <https://w3id.org/cdisc/cosmos/bc/C115789/dec/C25372>,
        <https://w3id.org/cdisc/cosmos/bc/C115789/dec/C82515>,
