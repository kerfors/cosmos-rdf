NCIT:C16735 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C16735" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C16735> ;
    cosmos_bc:categories "Protocol Milestones",
        "Subject Disposition" ;
    cosmos_bc:dataElementConcepts NCIT:C25372,
        NCIT:C25692,
        NCIT:C82517,
        NCIT:C82571,
        NCIT:C82977 ;
    cosmos_bc:definition "Consent by a patient to a surgical or medical procedure or participation in a clinical study after achieving an understanding of the relevant medical facts and the risks involved." ;
    cosmos_bc:ncitCode "C16735" ;
    cosmos_bc:packageDate "2023-12-12"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Nominal> ;
    cosmos_bc:shortName "Informed Consent" ;
    cosmos_bc:synonyms "Informed Consent Obtained" .

NCIT:C16809 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C16809" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C16809> ;
    cosmos_bc:categories "Diagnostic Imaging",
        "Medical Imaging" ;
    cosmos_bc:dataElementConcepts NCIT:C117511,
        NCIT:C117512,
        NCIT:C117529,
        NCIT:C117530,
        NCIT:C127786,
        NCIT:C13717,
        NCIT:C171000,
        NCIT:C25185,
        NCIT:C25372,
        NCIT:C25692,
        NCIT:C54215 ;
    cosmos_bc:definition "Imaging that uses radiofrequency waves and a strong magnetic field rather than x-rays to provide detailed pictures of internal organs and tissues. The technique is valuable for the diagnosis of many pathologic conditions, including cancer, heart and vascular disease, stroke, and joint and musculoskeletal disorders." ;
    cosmos_bc:ncitCode "C16809" ;
    cosmos_bc:packageDate "2023-12-12"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C16502 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Nominal> ;
    cosmos_bc:shortName "Magnetic Resonance Imaging" ;
    cosmos_bc:synonyms "MRI",
        "MRI Scan",
        "Magnetic Resonance",
        "NMR",
        "NMR Imaging" .

NCIT:C168125 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C168125" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C168125> ;
    cosmos_bc:categories "Cardiovascular Examination",
        "Vital Signs" ;
    cosmos_bc:coding <http://loinc.org/44971-0> ;
    cosmos_bc:dataElementConcepts NCIT:C42574,
        NCIT:C70856,
        NCIT:C82515 ;
    cosmos_bc:definition "An assessment performed to estimate peripheral perfusion and hydration status. The test is most often conducted by applying constant manual pressure for a set time on a patient's nail bed and then releasing while observing the length of time it takes for color to return to the tissue. A prolonged return to baseline coloring may indicate compromise of peripheral blood flow." ;
    cosmos_bc:ncitCode "C168125" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C122008 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Capillary Refill Test" ;
    cosmos_bc:synonyms "CPLRFLT",
        "Capillary Refill Time" .

NCIT:C17007 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C17007" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C17007> ;
    cosmos_bc:categories "Diagnostic Imaging",
        "Medical Imaging",
        "Tomography" ;
    cosmos_bc:dataElementConcepts NCIT:C117511,
        NCIT:C117512,
        NCIT:C117529,
        NCIT:C117530,
        NCIT:C127786,
        NCIT:C13717,
        NCIT:C171000,
        NCIT:C25185,
        NCIT:C25372,
        NCIT:C25692 ;
    cosmos_bc:definition "A technique for measuring the gamma radiation produced by collisions of electrons and positrons (anti-electrons) within living tissue. In positron emission tomography (PET), a subject is given a dose of a positron-emitting radionuclide attached to a metabolically active substance (for example, 2-fluoro-2-deoxy-D-glucose (FDG), which is similar to a naturally occurring sugar, glucose, with the addition of a radioactive fluorine atom). When living tissue containing the positron emitter is bombarded by electrons, gamma radiation produced by collisions of electrons and positrons is detected by a scanner, revealing in fine detail the tissue location of the metabolically-active substance administered." ;
    cosmos_bc:ncitCode "C17007" ;
    cosmos_bc:packageDate "2026-07-14"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C38093 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Nominal> ;
    cosmos_bc:shortName "Positron Emission Tomography" ;
    cosmos_bc:synonyms "PET",
        "PET Scan" .

NCIT:C170571 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170571" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170571> ;
    cosmos_bc:categories "Death Diagnosis and Details",
        "Indicator" ;
    cosmos_bc:dataElementConcepts NCIT:C70856,
        NCIT:C82515 ;
    cosmos_bc:definition "An indication as to whether the death event was witnessed by another individual." ;
    cosmos_bc:ncitCode "C170571" ;
    cosmos_bc:packageDate "2026-05-26"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C25180 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Nominal> ;
    cosmos_bc:shortName "Death Witnessed Indicator" ;
    cosmos_bc:synonyms "DTHWIND" .

NCIT:C170598 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170598" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170598> ;
    cosmos_bc:categories "Chemistry Tests",
        "Endocrine Tests",
        "Hormone Measurements",
        "Laboratory Tests" ;
    cosmos_bc:dataElementConcepts NCIT:C70713,
        NCIT:C70856,
        NCIT:C82515,
        NCIT:C93566 ;
    cosmos_bc:definition "A measurement of the thyroid status (function, disease diagnosis, or therapy effectiveness) in a biological specimen. This is calculated by a mathematical formula that takes into account the total thyroxine and unbound thyroxine binding globulins." ;
    cosmos_bc:ncitCode "C170598" ;
    cosmos_bc:packageDate "2025-07-01"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C74786 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Free Thyroxine Index" ;
    cosmos_bc:synonyms "T4FRIDX" .

NCIT:C170610 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170610" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170610> ;
    cosmos_bc:categories "Consent",
        "Disposition Events",
        "Other Events",
        "Subject Disposition",
        "Withdrawal" ;
    cosmos_bc:dataElementConcepts NCIT:C25372,
        NCIT:C25692,
        NCIT:C82517,
        NCIT:C82571,
        NCIT:C82977 ;
    cosmos_bc:definition "The subject or parent/guardian withdraws their consent for the subject to participate in certain protocol-specified study activities, but does not withdraw consent from participation in the study as a whole." ;
    cosmos_bc:ncitCode "C170610" ;
    cosmos_bc:packageDate "2023-12-12"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Nominal> ;
    cosmos_bc:shortName "Withdrawal of Consent From Protocol-Specified Activity" .

NCIT:C170618 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170618" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170618> ;
    cosmos_bc:categories "Respiratory System Findings" ;
    cosmos_bc:dataElementConcepts NCIT:C44279,
        NCIT:C70856,
        NCIT:C82515 ;
    cosmos_bc:definition "A parameter used in functional respiratory imaging, derived by dividing the airway volume of a specified intrapulmonary region by the total volume of the same specified intrapulmonary region." ;
    cosmos_bc:ncitCode "C170618" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C170457 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Specific Airway Volume" ;
    cosmos_bc:synonyms "SAWVOL" .

NCIT:C170619 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170619" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170619> ;
    cosmos_bc:categories "Respiratory System Findings" ;
    cosmos_bc:dataElementConcepts NCIT:C44279,
        NCIT:C70856,
        NCIT:C82515 ;
    cosmos_bc:definition "The volume of the entirety of the airway tissue in a specified intrapulmonary region." ;
    cosmos_bc:ncitCode "C170619" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C170457 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Airway Wall Volume" ;
    cosmos_bc:synonyms "AWWVOL" .

NCIT:C170620 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170620" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170620> ;
    cosmos_bc:categories "Pulmonary Function Test",
        "Respiratory System Findings" ;
    cosmos_bc:dataElementConcepts NCIT:C44279,
        NCIT:C70856,
        NCIT:C82515 ;
    cosmos_bc:definition "A measurement of the gas retention in a specified intrapulmonary space at the end of exhalation." ;
    cosmos_bc:ncitCode "C170620" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C38081 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Air Trapping Measurement" ;
    cosmos_bc:synonyms "AIRTRAP",
        "Air Trapping" .

NCIT:C170621 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170621" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170621> ;
    cosmos_bc:categories "Respiratory System Findings" ;
    cosmos_bc:dataElementConcepts NCIT:C48570,
        NCIT:C70856,
        NCIT:C82515 ;
    cosmos_bc:definition "The total volume of gas in a specified airway or set of airways at a specified point in time in the respiratory cycle, expressed as a proportion of the predicted normal value." ;
    cosmos_bc:ncitCode "C170621" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C170457 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Percent Predicted Airway Volume" ;
    cosmos_bc:synonyms "AWVOLPP" .

NCIT:C170622 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170622" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170622> ;
    cosmos_bc:categories "Respiratory System Findings" ;
    cosmos_bc:dataElementConcepts NCIT:C48570,
        NCIT:C70856,
        NCIT:C82515 ;
    cosmos_bc:definition "A parameter used in functional respiratory imaging, derived by dividing the airway volume of a specified intrapulmonary region by the total volume of the same specified intrapulmonary region, expressed as a proportion of the predicted normal value." ;
    cosmos_bc:ncitCode "C170622" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C170457 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Percent Predicted Specific Airway Volume" ;
    cosmos_bc:synonyms "SAWVOLPP" .

NCIT:C170623 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170623" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170623> ;
    cosmos_bc:categories "Pulmonary Function Test",
        "Respiratory System Findings" ;
    cosmos_bc:dataElementConcepts NCIT:C48570,
        NCIT:C70856,
        NCIT:C82515 ;
    cosmos_bc:definition "A measurement of respiratory tract resistance to airflow during inspiration and expiration, as a proportion of the predicted normal value." ;
    cosmos_bc:ncitCode "C170623" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C38081 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Percent Predicted Airway Resistance" ;
    cosmos_bc:synonyms "RAWPP" .

NCIT:C170624 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170624" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170624> ;
    cosmos_bc:categories "Pulmonary Function Test",
        "Respiratory System Findings" ;
    cosmos_bc:dataElementConcepts NCIT:C48570,
        NCIT:C70856,
        NCIT:C82515 ;
    cosmos_bc:definition "A measurement used to describe airway behavior irrespective of lung volume; it is calculated as airway resistance (Raw) multiplied by functional residual capacity (FRC), as a proportion of the predicted normal value." ;
    cosmos_bc:ncitCode "C170624" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C38081 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Percent Predicted Specific Airway Resistance" ;
    cosmos_bc:synonyms "Percent Predicted Sp Airway Resistance",
        "SRAWPP" .

NCIT:C170625 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170625" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170625> ;
    cosmos_bc:categories "Pulmonary Function Test",
        "Respiratory System Findings" ;
    cosmos_bc:dataElementConcepts NCIT:C48570,
        NCIT:C70856,
        NCIT:C82515 ;
    cosmos_bc:definition "A relative measurement (ratio or percentage) of the forced expiratory volume during the first three seconds of exhalation to the largest observed expired volume during a forced vital capacity maneuver." ;
    cosmos_bc:ncitCode "C170625" ;
