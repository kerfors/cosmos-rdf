        <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Transcription" ;
    cosmos_bc:synonyms "Genetic Transcription",
        "RNA Expression",
        "TRNSCPTN",
        "Transcriptional" .

