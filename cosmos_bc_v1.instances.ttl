    cosmos_bc:definition "The ratio of the abdominal circumference at the navel to maximum hip and buttocks circumference; looks at the proportion of fat stored on the body around the waist and hip. Carrying extra weight around the waist is a greater health risk than carrying extra weight around the hips or thighs." ;
    cosmos_bc:ncitCode "C17651" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
