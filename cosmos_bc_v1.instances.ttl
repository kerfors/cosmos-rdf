        <https://w3id.org/cdisc/cosmos/bc/C102116/dec/C82515>,
        <https://w3id.org/cdisc/cosmos/bc/C102116/dec/C82525>,
        <https://w3id.org/cdisc/cosmos/bc/C102116/dec/C82556> ;
    cosmos_bc:definition "A standardized classification scale, published by Oken et al. in 1982 for the Eastern Cooperative Oncology Group (ECOG), that utilizes a six point rating scale to assess a patient's functional status." ;
    cosmos_bc:ncitCode "C102116" ;
    cosmos_bc:packageDate "2026-07-14"^^xsd:date ;
