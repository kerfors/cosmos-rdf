        "PREGNN",
        "Pregnancy Count",
        "Total Number of Pregnancies" .

NCIT:C123909 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C123909" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123909> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Respiratory%20System%20Findings> ;
