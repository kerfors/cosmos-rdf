NCIT:C191036 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C191036" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C191036> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Clinical%20or%20Research%20Assessment%20Classification>,
        <https://w3id.org/cdisc/cosmos/bc/category/HBI>,
        <https://w3id.org/cdisc/cosmos/bc/category/HBI01>,
        <https://w3id.org/cdisc/cosmos/bc/category/Harvey-Bradshaw%20Index%20Clinical%20Classification>,
        <https://w3id.org/cdisc/cosmos/bc/category/QRS> ;
    cosmos_bc:dataElementConcepts <https://w3id.org/cdisc/cosmos/bc/C191036/dec/C25372>,
