    cosmos_bc:shortName "Progesterone Receptor Status" ;
    cosmos_bc:synonyms "PgR Status",
        "Progesterone Receptor" .

NCIT:C16150 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C16150" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C16150> ;
    cosmos_bc:categories "Chemistry Tests",
        "Endocrine Tests",
        "Hormone Measurements",
        "Laboratory Tests",
        "Protein or Enzyme Type Measurements" ;
    cosmos_bc:dataElementConcepts NCIT:C117062,
        NCIT:C171435,
        NCIT:C25372,
        NCIT:C25692,
        NCIT:C70713,
        NCIT:C70856,
        NCIT:C82515 ;
    cosmos_bc:definition "The estrogen receptor level measured in a primary tumor or in metastases.  There are essentially two distinct forms of breast cancer, one that tends to have an early onset and is characterized by an ER- status, and one that tends to have a late onset and is characterized by an ER+ status.  However, these two variants tend to overlap with respect to age, so it is possible for a young woman to have a \"late-onset\" form of breast cancer and for an older woman to have an \"early-onset\" variant of the disease." ;
    cosmos_bc:ncitCode "C16150" ;
    cosmos_bc:packageDate "2025-09-23"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C188928 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Ordinal> ;
    cosmos_bc:shortName "Estrogen Receptor Status" ;
    cosmos_bc:synonyms "ER Alpha Status",
        "ER Status",
        "ERA Status",
        "ESR Status",
        "ESR1 Status",
        "ESRA Status",
        "ESTRR Status",
        "Estrogen Receptor 1 Status",
        "Estrogen Receptor Alpha Status",
        "NR3A1 Status",
        "Nuclear Receptor Subfamily 3 Group A Member 1 Status" .

