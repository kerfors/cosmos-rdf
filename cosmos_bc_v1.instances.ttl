NCIT:C139267 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C139267" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C139267> ;
    cosmos_bc:categories "Reproductive Findings" ;
    cosmos_bc:dataElementConcepts NCIT:C70856,
        NCIT:C82515 ;
    cosmos_bc:definition "A measurement of the total number of birth events at which the fetus is of at least 20 weeks gestation, or of a birth weight of at least 350 grams if the gestational age is unknown, which is born without signs of life at the time of delivery, and with an Apgar score of zero at both one and five minutes." ;
    cosmos_bc:ncitCode "C139267" ;
    cosmos_bc:packageDate "2024-12-17"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
