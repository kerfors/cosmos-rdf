NCIT:C41184 a cosmos_bc:BiomedicalConcept,
        cosmos_bc:DataElementConcept ;
    dcterms:identifier "C41184" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C41184> ;
