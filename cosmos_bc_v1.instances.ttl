NCIT:C17208 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C17208" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C17208> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Gene%20Expression%20Process>,
        <https://w3id.org/cdisc/cosmos/bc/category/Genomic%20Findings>,
