        <https://w3id.org/cdisc/cosmos/bc/category/Trial%20Summary> ;
    cosmos_bc:definition "A sign, signal, circumstance, or symptom which serves to indicate or point out the cause, pathology, treatment, or issue of an attack of disease; the basis for initiation of a treatment for a disease or of a diagnostic test (causal, or symptomatic, or disease-specific indication)." ;
    cosmos_bc:ncitCode "C41184" ;
    cosmos_bc:packageDate "2025-07-01"^^xsd:date ;
