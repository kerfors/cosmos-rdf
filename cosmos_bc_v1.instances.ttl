NCIT:C16818 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C16818" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C16818> ;
    cosmos_bc:categories "Breast Cancer Diagnostic Procedures",
        "Diagnostic Imaging",
        "Medical Imaging" ;
    cosmos_bc:dataElementConcepts NCIT:C117511,
        NCIT:C117512,
