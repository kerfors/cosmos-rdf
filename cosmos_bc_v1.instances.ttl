        <https://w3id.org/cdisc/cosmos/bc/C170619/dec/C82515> ;
    cosmos_bc:definition "The volume of the entirety of the airway tissue in a specified intrapulmonary region." ;
    cosmos_bc:ncitCode "C170619" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
