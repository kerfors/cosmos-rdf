NCIT:C4872 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C4872" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C4872> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Cancer>,
        <https://w3id.org/cdisc/cosmos/bc/category/Carcinoma> ;
    cosmos_bc:definition "A carcinoma arising from the breast, most commonly the terminal ductal-lobular unit. It is the most common malignant tumor in females. Risk factors include country of birth, family history, menstrual and reproductive history, fibrocystic disease and epithelial hyperplasia, exogenous estrogens, contraceptive agents, and ionizing radiation. The vast majority of breast carcinomas are adenocarcinomas (ductal or lobular). Breast carcinoma spreads by direct invasion, by the lymphatic route, and by the blood vessel route. The most common site of lymph node involvement is the axilla." ;
    cosmos_bc:ncitCode "C4872" ;
    cosmos_bc:packageDate "2025-09-23"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:shortName "Breast Carcinoma" ;
    cosmos_bc:synonyms "Cancer of the Breast" .

