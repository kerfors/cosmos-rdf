NCIT:C102111 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C102111" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C102111> ;
    cosmos_bc:categories "AIMS",
        "AIMS01",
        "Abnormal Involuntary Movement Scale Clinical Classification",
        "Clinical or Research Assessment Classification",
        "QRS" ;
    cosmos_bc:dataElementConcepts NCIT:C25372,
        NCIT:C82515,
        NCIT:C82525,
        NCIT:C82556 ;
    cosmos_bc:definition "A standardized rating scale developed by William Guy in 1976 which is used to evaluate the severity of tardive dyskinesia in individuals taking neuroleptic agents. This instrument contains 5 sections with a total of 12 items pertaining to facial and oral movements, global judgments, trunk movements, dental status, and extremity movements. Each item is rated on either a 0 to 4 scale with 0 being none and 4 being severe, or as 'yes' or 'no.'" ;
    cosmos_bc:ncitCode "C102111" ;
    cosmos_bc:packageDate "2026-07-14"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C118969 ;
    cosmos_bc:shortName "Abnormal Involuntary Movement Scale Clinical Classification" ;
    cosmos_bc:synonyms "AIMS",
        "AIMS01" .

NCIT:C102116 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C102116" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C102116> ;
    cosmos_bc:categories "Clinical or Research Assessment Classification",
        "ECOG",
        "ECOG1",
        "Eastern Cooperative Oncology Group Performance Status Clinical Classification",
        "QRS" ;
    cosmos_bc:dataElementConcepts NCIT:C25372,
        NCIT:C82515,
        NCIT:C82525,
        NCIT:C82556 ;
    cosmos_bc:definition "A standardized classification scale, published by Oken et al. in 1982 for the Eastern Cooperative Oncology Group (ECOG), that utilizes a six point rating scale to assess a patient's functional status." ;
    cosmos_bc:ncitCode "C102116" ;
    cosmos_bc:packageDate "2026-07-14"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C118969 ;
    cosmos_bc:shortName "Eastern Cooperative Oncology Group Performance Status Clinical Classification" ;
    cosmos_bc:synonyms "ECOG" .

NCIT:C102117 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C102117" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C102117> ;
    cosmos_bc:categories "Clinical or Research Assessment Questionnaire",
        "EQ-5D-5L",
        "EQ5D02",
        "European Quality of Life Five Dimension Five Level Scale Questionnaire",
        "QRS" ;
    cosmos_bc:dataElementConcepts NCIT:C25372,
        NCIT:C82515,
        NCIT:C82525,
        NCIT:C82534,
        NCIT:C82556 ;
    cosmos_bc:definition "A standardized rating scale which is used as a measure of health outcome. This instrument is a descriptive system consisting of 5 dimensions: mobility, self-care, usual activity, pain/discomfort, and anxiety/depression. Each dimension has 5 levels ranging from no problem to extreme problem or incapable, which are assessed by the patient." ;
    cosmos_bc:ncitCode "C102117" ;
    cosmos_bc:packageDate "2026-07-14"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C91105 ;
    cosmos_bc:shortName "European Quality of Life Five Dimension Five Level Scale Questionnaire" ;
    cosmos_bc:synonyms "EQ-5D-5L",
        "EQ5D02",
        "European Quality of Life Five Dimension Five Level Scale Questionnaire" .

NCIT:C102118 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C102118" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C102118> ;
    cosmos_bc:categories "Clinical or Research Assessment Classification",
        "HAM-A",
        "HAMA",
        "HAMA1",
        "Hamilton Anxiety Rating Scale Clinical Classification",
        "QRS" ;
    cosmos_bc:dataElementConcepts NCIT:C25372,
        NCIT:C82515,
        NCIT:C82525,
        NCIT:C82556 ;
    cosmos_bc:definition "A standardized rating scale developed by M. Hamilton in 1959 which is used to evaluate the severity of an individual's state of neurotic anxiety. This instrument contains 14 questions or types of symptoms associated with anxiety such as fear, mood, insomnia, and somatic symptoms, which is completed during a semi-structured interview. Each symptom is rated on a scale of 0-4 with 0 being none and 4 being the most severe. A score of 0-17 is considered 'mild', while a score of 18-24 is 'mild to moderate' and a score greater than 24 is 'moderate to severe.'" ;
    cosmos_bc:ncitCode "C102118" ;
    cosmos_bc:packageDate "2026-07-14"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C118969 ;
    cosmos_bc:shortName "Hamilton Anxiety Rating Scale Clinical Classification" ;
    cosmos_bc:synonyms "HAM-A",
        "HAMA",
        "HAMA1" .

