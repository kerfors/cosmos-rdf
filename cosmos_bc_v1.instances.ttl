    cosmos_bc:shortName "Airway Wall Volume" ;
    cosmos_bc:synonyms "AWWVOL" .

NCIT:C170620 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170620" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170620> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Pulmonary%20Function%20Test>,
