        "RESPRATE" .

NCIT:C49679 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C49679" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C49679> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Blood%20Pressure>,
        <https://w3id.org/cdisc/cosmos/bc/category/Vital%20Signs> ;
    cosmos_bc:dataElementConcepts <https://w3id.org/cdisc/cosmos/bc/C49679/dec/C49669>,
        <https://w3id.org/cdisc/cosmos/bc/C49679/dec/C70856>,
        <https://w3id.org/cdisc/cosmos/bc/C49679/dec/C82515> ;
    cosmos_bc:definition "The mean pressure of the blood within the arterial circulation. The arterial pressure may be directly measured by insertion of an intra-arterial catheter connected to a transducer. The mean arterial pressure (MAP) can be calculated by subsequent analysis of the waveform. MAP can be approximated without an invasive procedure using the following formula: diastolic pressure plus 1/3 of the pulse pressure, where pulse pressure is systolic pressure - diastolic pressure." ;
    cosmos_bc:ncitCode "C49679" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C54706 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Mean Arterial Pressure" ;
    cosmos_bc:synonyms "MAP" .

