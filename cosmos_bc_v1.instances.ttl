    cosmos_bc:definition "Indicates the progesterone receptor level measured in a primary tumor or in metastases. (>=10 is positive if measured in fmols/mg cytosol protein; Otherwise use institutional standards)" ;
    cosmos_bc:ncitCode "C16149" ;
    cosmos_bc:packageDate "2025-09-23"^^xsd:date ;
