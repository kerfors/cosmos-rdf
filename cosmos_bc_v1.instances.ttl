        NCIT:C70856,
        NCIT:C82515,
        NCIT:C93566 ;
    cosmos_bc:definition "The total number of white blood cells that are basophils. It is calculated by multiplying the white blood cell count by the percent of basophils in the differential white blood cell count." ;
    cosmos_bc:ncitCode "C64470" ;
    cosmos_bc:packageDate "2025-07-01"^^xsd:date ;
