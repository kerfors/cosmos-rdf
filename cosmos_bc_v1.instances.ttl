    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Percent Predicted Specific Airway Volume" ;
    cosmos_bc:synonyms "SAWVOLPP" .

NCIT:C170623 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170623" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170623> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Pulmonary%20Function%20Test>,
        <https://w3id.org/cdisc/cosmos/bc/category/Respiratory%20System%20Findings> ;
