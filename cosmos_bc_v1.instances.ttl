    cosmos_bc:shortName "Forced Expiratory Volume in 1 Second to Slow Vital Capacity Ratio Measurement" ;
    cosmos_bc:synonyms "FEV1/SVC",
        "FEV1SVC" .

NCIT:C170627 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170627" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170627> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Pulmonary%20Function%20Test>,
        <https://w3id.org/cdisc/cosmos/bc/category/Respiratory%20System%20Findings> ;
    cosmos_bc:dataElementConcepts <https://w3id.org/cdisc/cosmos/bc/C170627/dec/C48570>,
        <https://w3id.org/cdisc/cosmos/bc/C170627/dec/C70856>,
