    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Carbon Monoxide Diffusing Capability Test" ;
    cosmos_bc:synonyms "DLCO",
        "Diffusion Capacity of Lung for CO",
        "Diffusion Capacity of the Lung for Carbon Monoxide",
        "PFT/DLCO",
        "Pulmonary Function Test/Carbon Monoxide Diffusing Capability",
        "TLCO",
        "Transfer Factor of Lung for CO" .

