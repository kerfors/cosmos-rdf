NCIT:C139217 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C139217" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C139217> ;
    cosmos_bc:categories "Musculoskeletal Finding",
        "Z-Score" ;
    cosmos_bc:dataElementConcepts NCIT:C13717,
        NCIT:C25185,
        NCIT:C70856,
        NCIT:C82515,
        NCIT:C82535 ;
    cosmos_bc:definition "A statistical score representing the number of standard deviations above or below what is expected for an individual's bone density based on his age, sex, weight, and race. Z-scores are most useful in evaluating low bone density in children, premenopausal women, and men younger than age fifty." ;
    cosmos_bc:ncitCode "C139217" ;
    cosmos_bc:packageDate "2025-07-01"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C68741 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Bone Mineral Density Z-Score" ;
    cosmos_bc:synonyms "BMDZ" .

