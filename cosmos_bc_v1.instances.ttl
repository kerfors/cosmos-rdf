        <https://w3id.org/cdisc/cosmos/bc/C170623/dec/C82515> ;
    cosmos_bc:definition "A measurement of respiratory tract resistance to airflow during inspiration and expiration, as a proportion of the predicted normal value." ;
    cosmos_bc:ncitCode "C170623" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
