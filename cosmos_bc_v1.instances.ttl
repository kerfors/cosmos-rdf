NCIT:C189635 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C189635" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C189635> ;
    cosmos_bc:categories "Pulmonary Function Test",
        "Respiratory System Findings" ;
    cosmos_bc:dataElementConcepts NCIT:C70856,
        NCIT:C82515 ;
    cosmos_bc:definition "A measurement of the efficiency of oxygen exchange by the lungs, which is calculated by multiplying the fraction of inspired oxygen (FiO2) (in %) to mean airway pressure (Mpaw) and dividing by pressure of arterial oxygen (PaO2)." ;
    cosmos_bc:ncitCode "C189635" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C38081 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Oxygenation Index" ;
    cosmos_bc:synonyms "OI" .

NCIT:C191036 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C191036" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C191036> ;
    cosmos_bc:categories "Clinical or Research Assessment Classification",
        "HBI",
        "HBI01",
        "Harvey-Bradshaw Index Clinical Classification",
        "QRS" ;
    cosmos_bc:dataElementConcepts NCIT:C25372,
        NCIT:C82515,
        NCIT:C82525,
        NCIT:C82556 ;
    cosmos_bc:definition "A standardized clinical tool, published in 1980 by Harvey et al. as a simplified version of the Crohn Disease Activity Index (CDAI), that assesses and scores five patient parameters (well-being, abdominal pain, number of liquid or soft stools, abdominal mass, and complications) to stratify Crohn's disease severity." ;
    cosmos_bc:ncitCode "C191036" ;
    cosmos_bc:packageDate "2026-07-14"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C118969 ;
    cosmos_bc:shortName "Harvey-Bradshaw Index Clinical Classification" ;
    cosmos_bc:synonyms "HBI",
        "HBI01" .

NCIT:C191038 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C191038" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C191038> ;
    cosmos_bc:categories "Clinical or Research Assessment Classification",
        "MVAI",
        "MVAI1",
        "Modified Van Assche Index Clinical Classification",
        "Modified Van Assche Index Clinical Classification Question" ;
    cosmos_bc:dataElementConcepts NCIT:C25372,
        NCIT:C82515,
        NCIT:C82525,
        NCIT:C82556 ;
    cosmos_bc:definition "A standardized scoring system originally developed in 2003 and modified in 2017 that utilizes quantitative radiological evaluation to assess the severity and disease response in perianal fistulizing Crohn disease." ;
    cosmos_bc:ncitCode "C191038" ;
    cosmos_bc:packageDate "2026-07-14"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:shortName "Modified Van Assche Index Clinical Classification" ;
    cosmos_bc:synonyms "MVAI",
        "MVAI1" .

NCIT:C191039 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C191039" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C191039> ;
    cosmos_bc:categories "Clinical or Research Assessment Classification",
        "QRS",
        "RUTG01",
        "RUTGEERTS SCORE",
        "Rutgeerts Score Clinical Classification" ;
    cosmos_bc:dataElementConcepts NCIT:C25372,
        NCIT:C82515,
        NCIT:C82525,
        NCIT:C82556 ;
    cosmos_bc:definition "A standardized scoring system developed by Rutgeerts et al. in 1990 that is used to assess postoperative disease recurrence in patients that have undergone ileocecal resection as treatment for Crohn disease." ;
    cosmos_bc:ncitCode "C191039" ;
    cosmos_bc:packageDate "2026-07-14"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C118969 ;
    cosmos_bc:shortName "Rutgeerts Score Clinical Classification" .

NCIT:C191040 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C191040" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C191040> ;
    cosmos_bc:categories "Clinical or Research Assessment Classification",
        "PASI FREDRIKSSON",
        "PASI03",
        "Psoriasis Area and Severity Index Fredriksson Version Clinical Classification",
        "QRS" ;
    cosmos_bc:dataElementConcepts NCIT:C25372,
        NCIT:C82515,
        NCIT:C82525,
        NCIT:C82556 ;
    cosmos_bc:definition "A standardized index developed in 1978 by Fredriksson et al. that combines psoriasis disease severity (measured as erythema, infiltration, and desquamation) and body surface area involvement over 4 body regions (head, trunk, upper and lower extremities) to assess progress during treatment." ;
    cosmos_bc:ncitCode "C191040" ;
    cosmos_bc:packageDate "2026-07-14"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C118969 ;
    cosmos_bc:shortName "Psoriasis Area and Severity Index Fredriksson Version Clinical Classification" ;
    cosmos_bc:synonyms "PASI FREDRIKSSON",
        "PASI Fredriksson Version",
        "PASI03" .

