    cosmos_bc:definition "The mean cell hemoglobin concentration (MCHC), which is the average concentration of hemoglobin in a given volume of blood. The MCHC is a calculated value derived from the measurement of hemoglobin and the hematocrit." ;
    cosmos_bc:ncitCode "C64798" ;
    cosmos_bc:packageDate "2025-07-01"^^xsd:date ;
