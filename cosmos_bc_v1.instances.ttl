NCIT:C112522 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C112522" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112522> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Clinical%20or%20Research%20Assessment%20Classification>,
        <https://w3id.org/cdisc/cosmos/bc/category/KFSS>,
        <https://w3id.org/cdisc/cosmos/bc/category/KFSS1>,
        <https://w3id.org/cdisc/cosmos/bc/category/Kurtzke%20Functional%20Systems%20Scores%20Clinical%20Classification>,
        <https://w3id.org/cdisc/cosmos/bc/category/QRS> ;
    cosmos_bc:dataElementConcepts <https://w3id.org/cdisc/cosmos/bc/C112522/dec/C25372>,
        <https://w3id.org/cdisc/cosmos/bc/C112522/dec/C82515>,
        <https://w3id.org/cdisc/cosmos/bc/C112522/dec/C82525>,
        <https://w3id.org/cdisc/cosmos/bc/C112522/dec/C82556> ;
    cosmos_bc:definition "A standardized rating scale developed by John F. Kurtzke in 1983 to measure the level of functioning in people with multiple sclerosis based on a standard neurological examination. The questionnaire contains 7 functional system; pyramidal functions, cerebellar functions, brainstem functions, sensory function, bowel and bladder function, visual function, and cerebral (or mental) functions. The functional system (FS) scores collected from this questionnaire are used in conjunction with observations and information regarding ambulation and the use of assistive devices to rate the EDSS." ;
    cosmos_bc:ncitCode "C112522" ;
    cosmos_bc:packageDate "2026-07-14"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C118969 ;
    cosmos_bc:shortName "Kurtzke Functional Systems Scores Clinical Classification" ;
    cosmos_bc:synonyms "KFSS" .

