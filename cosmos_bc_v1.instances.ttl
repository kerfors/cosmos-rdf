NCIT:C189635 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C189635" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C189635> ;
