    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Percent Predicted Airway Resistance" ;
    cosmos_bc:synonyms "RAWPP" .

NCIT:C170624 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170624" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170624> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Pulmonary%20Function%20Test>,
        <https://w3id.org/cdisc/cosmos/bc/category/Respiratory%20System%20Findings> ;
    cosmos_bc:dataElementConcepts <https://w3id.org/cdisc/cosmos/bc/C170624/dec/C48570>,
        <https://w3id.org/cdisc/cosmos/bc/C170624/dec/C70856>,
        <https://w3id.org/cdisc/cosmos/bc/C170624/dec/C82515> ;
    cosmos_bc:definition "A measurement used to describe airway behavior irrespective of lung volume; it is calculated as airway resistance (Raw) multiplied by functional residual capacity (FRC), as a proportion of the predicted normal value." ;
    cosmos_bc:ncitCode "C170624" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C38081 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Percent Predicted Specific Airway Resistance" ;
    cosmos_bc:synonyms "Percent Predicted Sp Airway Resistance",
        "SRAWPP" .

NCIT:C170625 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170625" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170625> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Pulmonary%20Function%20Test>,
        <https://w3id.org/cdisc/cosmos/bc/category/Respiratory%20System%20Findings> ;
    cosmos_bc:dataElementConcepts <https://w3id.org/cdisc/cosmos/bc/C170625/dec/C48570>,
        <https://w3id.org/cdisc/cosmos/bc/C170625/dec/C70856>,
        <https://w3id.org/cdisc/cosmos/bc/C170625/dec/C82515> ;
    cosmos_bc:definition "A relative measurement (ratio or percentage) of the forced expiratory volume during the first three seconds of exhalation to the largest observed expired volume during a forced vital capacity maneuver." ;
    cosmos_bc:ncitCode "C170625" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C38081 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Forced Expiratory Volume in 3 Seconds to Forced Vital Capacity Ratio Measurement" ;
    cosmos_bc:synonyms "FEV3/FVC",
        "FEV3FVC" .

NCIT:C170626 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170626" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170626> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Pulmonary%20Function%20Test>,
