        <https://w3id.org/cdisc/cosmos/bc/C170620/dec/C82515> ;
    cosmos_bc:definition "A measurement of the gas retention in a specified intrapulmonary space at the end of exhalation." ;
    cosmos_bc:ncitCode "C170620" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
