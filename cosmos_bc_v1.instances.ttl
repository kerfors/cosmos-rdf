    cosmos_bc:categories "Laboratory Tests",
        "Urinalysis" ;
    cosmos_bc:dataElementConcepts NCIT:C70713,
        NCIT:C70856,
        NCIT:C82515,
        NCIT:C93566 ;
    cosmos_bc:definition "Quantity of dimension one used to express on a scale from 0 to 14 the amount-of-substance concentration of hydrogen ion of dilute aqueous solution, calculated as the logarithm of the reciprocal of hydrogen-ion concentration in gram atoms per liter." ;
    cosmos_bc:ncitCode "C45997" ;
    cosmos_bc:packageDate "2025-07-01"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C158424 ;
