NCIT:C124425 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C124425" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C124425> ;
