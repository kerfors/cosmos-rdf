NCIT:C49676 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C49676" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C49676> ;
