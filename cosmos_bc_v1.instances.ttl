    cosmos_bc:shortName "Air Trapping Measurement" ;
    cosmos_bc:synonyms "AIRTRAP",
        "Air Trapping" .

NCIT:C170621 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170621" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170621> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Respiratory%20System%20Findings> ;
    cosmos_bc:dataElementConcepts <https://w3id.org/cdisc/cosmos/bc/C170621/dec/C48570>,
