NCIT:C62656 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C62656" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C62656> ;
    cosmos_bc:categories "Chemistry Tests",
        "Coagulation Study",
        "DILI",
        "Drug-Induced Liver Injury",
        "Laboratory Tests",
        "Prothrombin Activity Measurements" ;
    cosmos_bc:dataElementConcepts NCIT:C42574,
        NCIT:C70713,
        NCIT:C70856,
        NCIT:C82515,
        NCIT:C93566 ;
    cosmos_bc:definition "A measurement of the clotting time of plasma recalcified in the presence of excess tissue thromboplastin; it is a measure of the extrinsic pathway of coagulation. It is used to determine the clotting tendency of blood, in the measure of warfarin dosage, liver damage and vitamin K status. Factors measured are fibrinogen, prothrombin, and factors V, VII, and X." ;
    cosmos_bc:ncitCode "C62656" ;
    cosmos_bc:packageDate "2025-12-16"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C98774 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Prothrombin Time" ;
    cosmos_bc:synonyms "PT" .

