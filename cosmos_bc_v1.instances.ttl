        <https://w3id.org/cdisc/cosmos/bc/C170571/dec/C82515> ;
    cosmos_bc:definition "An indication as to whether the death event was witnessed by another individual." ;
    cosmos_bc:ncitCode "C170571" ;
    cosmos_bc:packageDate "2026-05-26"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C25180 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Nominal> ;
    cosmos_bc:shortName "Death Witnessed Indicator" ;
    cosmos_bc:synonyms "DTHWIND" .

NCIT:C170598 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170598" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170598> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Chemistry%20Tests>,
        <https://w3id.org/cdisc/cosmos/bc/category/Endocrine%20Tests>,
        <https://w3id.org/cdisc/cosmos/bc/category/Hormone%20Measurements>,
        <https://w3id.org/cdisc/cosmos/bc/category/Laboratory%20Tests> ;
    cosmos_bc:dataElementConcepts <https://w3id.org/cdisc/cosmos/bc/C170598/dec/C70713>,
        <https://w3id.org/cdisc/cosmos/bc/C170598/dec/C70856>,
        <https://w3id.org/cdisc/cosmos/bc/C170598/dec/C82515>,
        <https://w3id.org/cdisc/cosmos/bc/C170598/dec/C93566> ;
    cosmos_bc:definition "A measurement of the thyroid status (function, disease diagnosis, or therapy effectiveness) in a biological specimen. This is calculated by a mathematical formula that takes into account the total thyroxine and unbound thyroxine binding globulins." ;
    cosmos_bc:ncitCode "C170598" ;
    cosmos_bc:packageDate "2025-07-01"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C74786 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Free Thyroxine Index" ;
    cosmos_bc:synonyms "T4FRIDX" .

NCIT:C170610 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C170610" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170610> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Consent>,
        <https://w3id.org/cdisc/cosmos/bc/category/Disposition%20Events>,
        <https://w3id.org/cdisc/cosmos/bc/category/Other%20Events>,
        <https://w3id.org/cdisc/cosmos/bc/category/Subject%20Disposition>,
        <https://w3id.org/cdisc/cosmos/bc/category/Withdrawal> ;
    cosmos_bc:dataElementConcepts <https://w3id.org/cdisc/cosmos/bc/C170610/dec/C25372>,
