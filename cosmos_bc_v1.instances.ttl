NCIT:C70793 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C70793" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C70793> ;
    cosmos_bc:categories "Trial Summary" ;
    cosmos_bc:dataElementConcepts NCIT:C117458,
        NCIT:C117460,
        NCIT:C49691,
        NCIT:C83445,
        NCIT:C83447 ;
    cosmos_bc:definition "An entity such as an individual, company, institution, group, or organization which takes responsibility for the initiation, management, and/or financing of a clinical study. The sponsor does not actually conduct the investigation unless the sponsor is a sponsor-investigator. A person other than an individual (e.g., corporation or agency) that uses one or more of its own employees to conduct research it has initiated is considered to be a sponsor, and the employees are considered to be investigators. [21 CFR P.50.3(k)] [21 CFR P.50.102(j)] [21 CFR P.312.3]" ;
    cosmos_bc:ncitCode "C70793" ;
    cosmos_bc:packageDate "2025-07-01"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C48355 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Nominal> ;
