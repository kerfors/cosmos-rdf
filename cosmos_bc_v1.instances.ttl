    cosmos_bc:dataElementConcepts NCIT:C25372,
        NCIT:C82515,
        NCIT:C82525,
        NCIT:C82556 ;
    cosmos_bc:definition "A standardized rating scale developed by Marshal and Tanner in 1970, which is a classification system used to measure physical development in children, adolescents and adults. The boy version of the tanner scale assesses the different stages of physical maturity based on testicular volume, genitalia growth and the development of pubic hair. This instrument has 5 stages." ;
    cosmos_bc:ncitCode "C124703" ;
    cosmos_bc:packageDate "2026-07-14"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
