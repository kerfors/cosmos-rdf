NCIT:C106550 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C106550" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C106550> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Reproductive%20Findings> ;
    cosmos_bc:dataElementConcepts <https://w3id.org/cdisc/cosmos/bc/C106550/dec/C70856>,
        <https://w3id.org/cdisc/cosmos/bc/C106550/dec/C82515> ;
    cosmos_bc:definition "A measurement of the total number of instances in which there has been a termination of pregnancy happening before the fetus is able to sustain independent life." ;
    cosmos_bc:ncitCode "C106550" ;
    cosmos_bc:packageDate "2024-12-17"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C25337 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Number of Abortions" ;
    cosmos_bc:synonyms "ABORTN" .

NCIT:C106551 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C106551" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C106551> ;
