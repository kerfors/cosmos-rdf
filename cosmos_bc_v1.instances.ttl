        <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Absolute Neutrophil Count" ;
    cosmos_bc:synonyms "NEUT",
        "Neutrophils",
        "Total Neutrophil Count" .

