NCIT:C123567 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C123567" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123567> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Pulmonary%20Function%20Test>,
        <https://w3id.org/cdisc/cosmos/bc/category/Respiratory%20System%20Findings> ;
    cosmos_bc:dataElementConcepts <https://w3id.org/cdisc/cosmos/bc/C123567/dec/C70856>,
        <https://w3id.org/cdisc/cosmos/bc/C123567/dec/C82515> ;
    cosmos_bc:definition "The measurement of the ability of the lung to store energy, which is required for passive expiration. Reactance consists of two components: the negative component reflects capacitive behavior (C) and corresponds to both the thoraco-pulmonary elasticity and to changes in the available lung volumes in the distal compartments of the lung; the positive component of reactance has inertial characteristics (I) describing the moving air column in the bronchial tree." ;
    cosmos_bc:ncitCode "C123567" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C38081 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Pulmonary Reactance" ;
    cosmos_bc:synonyms "PLMXRS" .

NCIT:C123568 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C123568" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123568> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Pulmonary%20Function%20Test>,
        <https://w3id.org/cdisc/cosmos/bc/category/Respiratory%20System%20Findings> ;
    cosmos_bc:dataElementConcepts <https://w3id.org/cdisc/cosmos/bc/C123568/dec/C48570>,
        <https://w3id.org/cdisc/cosmos/bc/C123568/dec/C70856>,
        <https://w3id.org/cdisc/cosmos/bc/C123568/dec/C82515> ;
    cosmos_bc:definition "The ratio of the amount of carbon dioxide produced to the amount of oxygen consumed in one breath. This ratio is used to estimate the respiratory quotient, which indicates what type of fuel source the body is metabolising to provide energy." ;
    cosmos_bc:ncitCode "C123568" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C38081 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Respiratory Exchange Ratio" ;
    cosmos_bc:synonyms "RER" .

