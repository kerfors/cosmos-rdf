        <https://w3id.org/cdisc/cosmos/bc/C170610/dec/C82977> ;
    cosmos_bc:definition "The subject or parent/guardian withdraws their consent for the subject to participate in certain protocol-specified study activities, but does not withdraw consent from participation in the study as a whole." ;
    cosmos_bc:ncitCode "C170610" ;
    cosmos_bc:packageDate "2023-12-12"^^xsd:date ;
