NCIT:C81247 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C81247" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C81247> ;
    cosmos_bc:categories "Subject Characteristics" ;
    cosmos_bc:dataElementConcepts NCIT:C25372,
        NCIT:C70856,
        NCIT:C82515 ;
    cosmos_bc:definition "The best estimated due date is determined by: last menstrual period (LMP) if confirmed by early ultrasound or no ultrasound performed, or early ultrasound if no known LMP or the ultrasound is not consistent with LMP, or known date of fertilization (e.g. Assisted Reproductive Technology (ART), Intrauterine Insemination (IUI)). Notes: 1. Ultrasound margin of error and \"early\" to be defined by SMFM/ACOG/NICHD workshop. 2. Pregnancy should not be re-dated by a later ultrasound after a best obstetrical estimate of EDD has been established. (adapted from reVITALize)" ;
    cosmos_bc:ncitCode "C81247" ;
    cosmos_bc:packageDate "2026-07-14"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C25164 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Temporal> ;
    cosmos_bc:shortName "Expected Date of Confinement" ;
    cosmos_bc:synonyms "Due Date",
        "EDC",
        "EDD",
        "EDLVRDTC",
        "Estimated Date of Confinement",
        "Estimated Date of Delivery",
        "Estimated Due Date",
        "Expected Date of Confinement" .

