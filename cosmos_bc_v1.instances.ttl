    cosmos_bc:categories "Procedures",
        "Surgeries" ;
    cosmos_bc:definition "Breast conservation treatment is defined as excision of the primary tumor and adjacent breast tissue, followed by radiation therapy.  This procedure is also referred to as lumpectomy, segmental mastectomy, or partial mastectomy. (from Consensus Statements: Treatment of Early-stage Breast Cancer, 1990)" ;
    cosmos_bc:ncitCode "C15280" ;
    cosmos_bc:packageDate "2025-09-23"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:shortName "Breast Conservation Treatment" .

