NCIT:C160723 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C160723" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C160723> ;
    cosmos_bc:categories "Disease Response",
        "Tumor Results" ;
    cosmos_bc:dataElementConcepts NCIT:C171435,
        NCIT:C25372,
        NCIT:C25692,
        NCIT:C70713,
        NCIT:C70856,
        NCIT:C82515 ;
    cosmos_bc:definition "A score estimated from routine pathologic sections of the primary breast tumor site and the regional lymph nodes after the completion of neoadjuvant therapy. Variables used in the calculation include: primary tumor bed area, overall cancer cellularity, percentage of cancer that is in situ disease, number of positive lymph nodes, and diameter of largest metastasis. These scores are divided into 4 classes that stratify patients based on their chance of disease recurrence." ;
    cosmos_bc:ncitCode "C160723" ;
    cosmos_bc:packageDate "2025-09-23"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Ordinal> ;
    cosmos_bc:shortName "Residual Cancer Burden Index" ;
    cosmos_bc:synonyms "RCB Index" .

