        NCIT:C93566 ;
    cosmos_bc:definition "The mean cell hemoglobin (MCH), which is the average amount of hemoglobin in the average red cell. The MCH is a calculated value derived from the measurement of hemoglobin and the red cell count." ;
    cosmos_bc:ncitCode "C64797" ;
    cosmos_bc:packageDate "2025-07-01"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
