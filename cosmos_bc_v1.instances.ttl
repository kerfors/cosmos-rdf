    dcterms:identifier "C139266" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C139266> ;
    cosmos_bc:categories "Reproductive Findings" ;
    cosmos_bc:dataElementConcepts NCIT:C70856,
        NCIT:C82515 ;
    cosmos_bc:definition "A measurement of the total number of live birth events at which the gestational age of the neonate is less than 37 weeks and 0 days." ;
    cosmos_bc:ncitCode "C139266" ;
    cosmos_bc:packageDate "2024-12-17"^^xsd:date ;
