NCIT:C48281 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C48281" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C48281> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Trial%20Summary> ;
    cosmos_bc:dataElementConcepts <https://w3id.org/cdisc/cosmos/bc/C48281/dec/C117458>,
