        NCIT:C171000,
        NCIT:C25185,
        NCIT:C25372,
        NCIT:C25692,
        NCIT:C54215 ;
    cosmos_bc:definition "A type of radiography used specifically to examine breast tissue. The procedure utilizes a low-dose of x-rays or radiation to generate an image. A mammography exam or mammogram, is used as a screening tool to detect early breast cancer in women experiencing no symptoms and to detect and diagnose breast disease." ;
    cosmos_bc:ncitCode "C16818" ;
    cosmos_bc:packageDate "2025-09-23"^^xsd:date ;
