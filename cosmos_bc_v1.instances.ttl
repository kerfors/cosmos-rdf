NCIT:C123565 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C123565" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123565> ;
    cosmos_bc:categories "Pulmonary Function Test",
        "Respiratory System Findings" ;
    cosmos_bc:dataElementConcepts NCIT:C48570,
        NCIT:C70856,
        NCIT:C82515 ;
    cosmos_bc:definition "A calculated ratio of the forced expiratory volume in one second to the largest observed expired volume during the first six seconds of a forced vital capacity (FVC) maneuver." ;
    cosmos_bc:ncitCode "C123565" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C38081 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Forced Expiratory Volume in 1 Second to Forced Vital Capacity in 6 Seconds" ;
    cosmos_bc:synonyms "FEV1/FVC6",
        "FEV1FVC6" .

NCIT:C123566 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C123566" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123566> ;
