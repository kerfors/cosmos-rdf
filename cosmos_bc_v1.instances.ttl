NCIT:C62667 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C62667" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C62667> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Diagnostic%20Imaging>,
        <https://w3id.org/cdisc/cosmos/bc/category/Diagnostic%20Procedure>,
        <https://w3id.org/cdisc/cosmos/bc/category/NM>,
        <https://w3id.org/cdisc/cosmos/bc/category/Nuclear%20Medicine> ;
    cosmos_bc:dataElementConcepts <https://w3id.org/cdisc/cosmos/bc/C62667/dec/C117511>,
        <https://w3id.org/cdisc/cosmos/bc/C62667/dec/C117512>,
        <https://w3id.org/cdisc/cosmos/bc/C62667/dec/C117529>,
        <https://w3id.org/cdisc/cosmos/bc/C62667/dec/C117530>,
        <https://w3id.org/cdisc/cosmos/bc/C62667/dec/C127786>,
        <https://w3id.org/cdisc/cosmos/bc/C62667/dec/C13717>,
        <https://w3id.org/cdisc/cosmos/bc/C62667/dec/C171000>,
        <https://w3id.org/cdisc/cosmos/bc/C62667/dec/C25185>,
        <https://w3id.org/cdisc/cosmos/bc/C62667/dec/C25372>,
        <https://w3id.org/cdisc/cosmos/bc/C62667/dec/C25692> ;
    cosmos_bc:definition "An imaging technique that uses a small dose of a radioactive chemical (isotope) called a tracer that can detect sites of cancer growth, trauma, infection or degenerative disorders. The tracer, which is either injected into a vein or swallowed, travels through the bloodstream to the target organ, and emits gamma rays, which are detected by a gamma camera and analyzed by a computer to form an image of the target organ." ;
    cosmos_bc:ncitCode "C62667" ;
    cosmos_bc:packageDate "2026-07-14"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C16502 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Nominal> ;
    cosmos_bc:shortName "Radionuclide Imaging" ;
    cosmos_bc:synonyms "Gamma Scan",
        "Nuclear Medicine",
        "Radioimaging",
        "Scintigraphy" .

NCIT:C63321 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C63321" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C63321> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Blood%20Cell%20Counts>,
        <https://w3id.org/cdisc/cosmos/bc/category/Hematology%20Tests>,
        <https://w3id.org/cdisc/cosmos/bc/category/Laboratory%20Tests>,
        <https://w3id.org/cdisc/cosmos/bc/category/Leukocyte%20Counts>,
        <https://w3id.org/cdisc/cosmos/bc/category/Neutrophil%20Counts> ;
