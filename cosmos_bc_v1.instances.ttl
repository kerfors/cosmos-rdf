NCIT:C15280 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C15280" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C15280> ;
