        <https://w3id.org/cdisc/cosmos/bc/C100945/dec/C70856>,
        <https://w3id.org/cdisc/cosmos/bc/C100945/dec/C82515> ;
    cosmos_bc:definition "The force of a heart contraction measured by the difference between the diastolic and systolic blood pressure measurements." ;
    cosmos_bc:ncitCode "C100945" ;
    cosmos_bc:packageDate "2026-03-31"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C19332 ;
