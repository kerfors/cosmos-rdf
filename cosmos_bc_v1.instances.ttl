NCIT:C19635 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C19635" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C19635> ;
    cosmos_bc:categories <https://w3id.org/cdisc/cosmos/bc/category/Gene%20Abnormality>,
        <https://w3id.org/cdisc/cosmos/bc/category/Gene%20Expression%20Analysis>,
        <https://w3id.org/cdisc/cosmos/bc/category/Genetic%20Testing>,
        <https://w3id.org/cdisc/cosmos/bc/category/Molecular%20Analysis>,
        <https://w3id.org/cdisc/cosmos/bc/category/Molecular%20Genetic%20Variation> ;
    cosmos_bc:dataElementConcepts <https://w3id.org/cdisc/cosmos/bc/C19635/dec/C117062>,
        <https://w3id.org/cdisc/cosmos/bc/C19635/dec/C171435>,
        <https://w3id.org/cdisc/cosmos/bc/C19635/dec/C25372>,
        <https://w3id.org/cdisc/cosmos/bc/C19635/dec/C25692>,
        <https://w3id.org/cdisc/cosmos/bc/C19635/dec/C70713>,
        <https://w3id.org/cdisc/cosmos/bc/C19635/dec/C70856>,
        <https://w3id.org/cdisc/cosmos/bc/C19635/dec/C82515> ;
    cosmos_bc:definition "A mutation that is typically a heritable, permanent change in the nucleotide sequence of the BRCA1 gene. Single nucleotide substitutions and small deletions or insertions (1-20 bases) account for the majority of mutations in the BRCA1 gene. Approximately 75% of these alterations result in a truncated form of the breast cancer type 1 susceptibility protein. Mutations in the BRCA1 gene predispose individuals to breast and ovarian cancers." ;
    cosmos_bc:ncitCode "C19635" ;
    cosmos_bc:packageDate "2025-09-23"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C159204 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Ordinal> ;
    cosmos_bc:shortName "BRCA1 Gene Mutation" ;
    cosmos_bc:synonyms "BRCA1",
        "BRCA1 Mutation",
        "BROVCA1 Gene Mutation",
        "Breast Cancer 1 Gene Mutation",
        "Mutation of the BRCA1 Gene" .

