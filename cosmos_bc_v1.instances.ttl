NCIT:C52159 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C52159" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C52159> ;
    cosmos_bc:categories "Assays",
        "Diagnostic Assays",
        "Diagnostic Procedures",
        "Diagnostic Tests",
        "Gene Expression Analysis" ;
    cosmos_bc:dataElementConcepts NCIT:C171435,
        NCIT:C25372,
        NCIT:C25692,
        NCIT:C70713,
        NCIT:C70856,
        NCIT:C82535 ;
    cosmos_bc:definition "A diagnostic assay that quantifies the likelihood of breast cancer recurrence in women with newly diagnosed, early stage breast cancer. In addition to predicting distant disease recurrence, Oncotype DX also assesses the benefit from certain types of chemotherapy. The assay, performed using formalin-fixed, paraffin-embedded tumor tissue, analyzes the expression of a panel of 21 genes and the results are provided as a Recurrence Score (0-100). The gene panel was selected and the Recurrence Score calculation was derived through extensive laboratory testing and multiple independent clinical development studies. Oncotype DX is validated for use in breast cancer patients whose disease is newly diagnosed, stage I or II, node-negative, estrogen receptor-positive and who will be treated with tamoxifen." ;
    cosmos_bc:ncitCode "C52159" ;
    cosmos_bc:packageDate "2025-09-23"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:parentConceptId NCIT:C18194 ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Narrative>,
        <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "Oncotype DX Breast Cancer Assay" ;
    cosmos_bc:synonyms "Oncotype DX" .

NCIT:C53556 a cosmos_bc:BiomedicalConcept ;
    dcterms:identifier "C53556" ;
    skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C53556> ;
    cosmos_bc:categories "Cancer Biomarkers",
        "Gene Expression Analysis",
        "Gene Products",
        "Genetic Testing",
        "Genetic Variation",
        "Genetic Variation Analysis" ;
    cosmos_bc:dataElementConcepts NCIT:C117062,
        NCIT:C171435,
        NCIT:C25372,
        NCIT:C25692,
        NCIT:C70713,
        NCIT:C70856 ;
    cosmos_bc:definition "A biologic subset of breast carcinoma defined by high expression of HER2, GRB7, and TRAP100, and by lack of expression of estrogen receptor (ER)." ;
    cosmos_bc:ncitCode "C53556" ;
    cosmos_bc:packageDate "2025-09-23"^^xsd:date ;
    cosmos_bc:packageType <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/PackageTypeEnum#bc> ;
    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Ordinal>,
        <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Quantitative> ;
    cosmos_bc:shortName "HER2-Positive Breast Carcinoma" ;
    cosmos_bc:synonyms "ERBB2 Overexpressing Subtype of Breast Carcinoma",
        "HER2 Overexpressing Breast Carcinoma",
