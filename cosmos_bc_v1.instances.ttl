    cosmos_bc:resultScales <https://www.cdisc.org/cosmos/biomedical_concept_v1.0/BiomedicalConceptResultScaleEnum#Nominal> ;
    cosmos_bc:shortName "Trial Phase" ;
    cosmos_bc:synonyms "TPHASE",
        "Trial Phase Classification",
        "phase",
        "phase (of clinical development)" .

